# ResolveAI Platform Environment Configuration Example
# Copy this file to each service's respective .env or configure individually.

# 1. MongoDB Database
MONGODB_URI=mongodb://127.0.0.1:27017/resolveai

# 2. Backend API
PORT=5000
NODE_ENV=development
JWT_SECRET=resolveai_super_secret_jwt_key_2026
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=resolveai_internal_secret_key_2026

# 3. AI Microservice (FastAPI + ChromaDB)
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
LLM_PROVIDER=local
LLM_MODEL_NAME=grounded-local-v1
CHROMA_PERSIST_DIR=./data/chroma

# Optional LLM API Keys (Supports Gemini, OpenAI, Ollama)
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# 4. Frontend Application
VITE_API_URL=/api
VITE_SOCKET_URL=http://localhost:5000
